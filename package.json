{
  "name": "leaveanote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "functions:install": "npm install --prefix functions",
    "emulators:start": "npx firebase emulators:start --only hosting,functions,firestore",
    "build": "tsc -b && vite build",
    "build:prod": "vite build",
    "lint": "eslint src eslint.config.js vite.config.ts tailwind.config.js",
    "test": "node --test tests/**/*.test.mjs",
    "test:functions": "npm --prefix functions run test",
    "preview": "vite preview",
    "deploy": "npm run build && npm run test && npx firebase deploy --only hosting,functions"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@stripe/firestore-stripe-payments": "^0.0.6",
    "autoprefixer": "^10.4.22",
    "date-fns": "^4.1.0",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.25",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "postcss": "^8.5.6",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^7.10.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/qrcode.react": "^3.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.8.0",
    "globals": "^16.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11"
  }
}
